{
  "name": "mangatech",
  "version": "1.0.1",
  "description": "A desktop application for searching, downloading, and reading manga content",
  "main": "dist/main.js",
  "homepage": "./",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lycoris69/MangaTech.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json && cross-env NODE_ENV=development electron dist/main.js",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "electron": "electron dist/main.js",
    "pack": "electron-builder",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm install --include=optional sharp && npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder --win --linux",
    "clean": "rimraf dist release logs node_modules/.cache"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "manga",
    "reader"
  ],
  "author": "MangaTech Team",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.6.3",
    "@types/react": "^18.2.22",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.7.2",
    "@typescript-eslint/parser": "^6.7.2",
    "@vitejs/plugin-react": "^4.0.4",
    "concurrently": "^8.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^24.6.4",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "fast-check": "^3.13.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.0.3",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "vite": "^7.2.7",
    "vite-plugin-electron": "^0.14.1"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "joi": "^18.0.2",
    "puppeteer": "^24.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "sharp": "^0.34.5",
    "winston": "^3.19.0"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "^0.34.5",
    "@img/sharp-win32-x64": "^0.34.5"
  },
  "build": {
    "appId": "com.mangatech.app",
    "productName": "MangaTech",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "mac": {
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "Lycoris69",
      "repo": "MangaTech"
    }
  }
}